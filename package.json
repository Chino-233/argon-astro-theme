{
  "name": "argon-astro-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "admin:setup": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.13",
    "astro": "7.4.12",
    "katex": "0.19.1",
    "marked": "16.4.2",
    "nodemailer": "10.5.0",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.2"
  },
  "overrides": {
    "unifont": "0.7.4"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.12",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "^2.16.0"
  }
}
