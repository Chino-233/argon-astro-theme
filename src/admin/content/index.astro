---
import { isOwner, preventCaching } from '../../lib/auth';
import { ownerEntries, renderEditorSource } from '../../lib/editor';
import { publishedEditorialEntry } from '../../lib/editor-store';
import { site, stripTags, terms } from '../../lib/site';
import blockScripts from '../../data/editor-scripts.json';

preventCaching(Astro.response.headers);
if (!isOwner(Astro.cookies)) {
  Astro.response.headers.set('Location', '/auth/?return=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
  return new Response(null, { status: 303, headers: Astro.response.headers });
}
const query = Astro.url.searchParams;
const type = query.get('type') === 'shuoshuo' ? 'shuoshuo' : 'post';
const label = type === 'post' ? '文章' : '说说';
const records = await ownerEntries();
const candidate = records.get(query.get('id') ?? '');
const selected = candidate?.entry.type === type ? candidate : undefined;
const editing = Boolean(selected || query.has('new'));
const live = selected && publishedEditorialEntry(selected);
const base = '/auth/content/?type=' + type;
const items = [...records.values()].filter(({ entry }) => entry.type === type)
  .sort((a, b) => Date.parse(b.entry.published) - Date.parse(a.entry.published));
const state = (record: typeof items[number]) => !publishedEditorialEntry(record) ? 'draft' : record.entry.visibility === 'private' ? 'private' : 'publish';
const status = (record: typeof items[number]) => !publishedEditorialEntry(record) ? '草稿' : record.draft ? '有未发布修改' : record.entry.visibility === 'private' ? '私密' : record.entry.visibility === 'password' ? '密码保护' : '已发布';
const filter = query.get('status') ?? 'all';
const search = query.get('s')?.trim() ?? '';
const matching = items.filter((record) => (filter === 'all' || state(record) === filter) && (!search || (record.entry.title + ' ' + stripTags(record.entry.html)).toLocaleLowerCase().includes(search.toLocaleLowerCase())));
const page = Math.max(1, Number(query.get('page')) || 1);
const count = Math.ceil(matching.length / 20);
const source = selected?.source ?? '';
const originalFormat = selected?.format ?? 'html';
const initialHtml = originalFormat === 'markdown' ? renderEditorSource(source, 'markdown') : source;
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{editing ? '编辑' + label : label + '管理'} ‹ {site.title}</title>
    <link rel="stylesheet" href="/assets/argon/content-admin.css?v=20261118" />
    {editing && type === 'post' && <>
      <script is:inline type="importmap">{"imports":{"@wordpress/latex-to-mathml":"/assets/argon/vendor/wordpress/wp-includes/js/dist/script-modules/latex-to-mathml/index.min.js"}}</script>
      {['components/style', 'block-editor/style', 'block-library/style', 'block-library/editor', 'block-library/theme', 'format-library/style'].map((path) => <link rel="stylesheet" href={'/assets/argon/vendor/wordpress/wp-includes/css/dist/' + path + '.min.css'} />)}
      <link rel="stylesheet" href="/assets/argon/vendor/wordpress/wp-includes/css/dashicons.min.css" />
      <link rel="stylesheet" href="/assets/argon/block-content.css" />
      {blockScripts.map((script) => <>
        <script is:inline src={'/assets/argon/vendor/wordpress/' + script.path}></script>
        {script.handle === 'lodash' && <script is:inline>window.lodash = window._.noConflict();</script>}
        {script.handle === 'wp-i18n' && <script is:inline src="/assets/argon/blocks-zh.js"></script>}
      </>)}
      <script is:inline src="/assets/argon/content-blocks.js"></script>
    </>}
    {editing && type === 'shuoshuo' && <>
      <script is:inline src="/assets/argon/vendor/tinymce/tinymce.min.js"></script>
      <script is:inline src="/assets/argon/tinymce-zh.js"></script>
    </>}
    <script is:inline defer src="/assets/argon/content-admin.js?v=20261118"></script>
  </head>
  <body>
    <header class="admin-bar"><a href="/auth/">站主管理</a><a href="/" target="_blank" rel="noopener">{site.title} ↗</a></header>
    <aside class="admin-sidebar"><nav aria-label="站主管理">
      <a href="/auth/">仪表盘</a>
      <a class:list={{ current: type === 'post' }} href="/auth/content/?type=post">文章</a>
      {type === 'post' && <div class="submenu"><a href={base}>所有文章</a><a href={base + '&new=1'}>写文章</a></div>}
      <a class:list={{ current: type === 'shuoshuo' }} href="/auth/content/?type=shuoshuo">说说</a>
      {type === 'shuoshuo' && <div class="submenu"><a href={base}>所有说说</a><a href={base + '&new=1'}>发表说说</a></div>}
      <a href="/auth/comments/">评论</a><a href="/auth/argon/">Argon 主题选项</a>
    </nav></aside>
    <main class="admin-content">
      <div class="page-heading"><h1>{editing ? (selected ? '编辑' : type === 'post' ? '写' : '发表') + label : label}</h1><a class="button" href={editing ? base : base + '&new=1'}>{editing ? '返回列表' : type === 'post' ? '写文章' : '发表说说'}</a></div>
      <div id="editor-message" class="notice" role="status" hidden={!query.has('saved')}>{query.get('saved') === 'draft' ? '草稿已保存。' : '内容已更新。'}</div>
      {editing ? <form id="content-editor" action="/auth/content/save/" method="post" data-editor={type === 'post' ? 'blocks' : 'classic'} data-original-format={originalFormat} data-live={live ? 'true' : 'false'}>
        <input type="hidden" name="id" value={selected?.entry.id ?? ''} />
        <input type="hidden" name="type" value={type} />
        <input type="hidden" name="revision" value={selected?.revision ?? ''} />
        <input type="hidden" name="format" value={originalFormat} />
        <input type="hidden" name="published" value={selected?.entry.published ?? ''} />
        <div class="edit-columns">
          <div class="edit-main">
            <label class="screen-reader-text" for="entry-title">标题</label><input id="entry-title" class="title-input" name="title" value={selected?.entry.title ?? ''} maxlength="200" placeholder={type === 'post' ? '在此输入标题' : '在此输入标题（可选）'} />
            <div class="permalink"><strong>固定链接</strong> {selected ? <a id="entry-permalink" href={selected.entry.path} target="_blank" rel="noopener">{site.url.replace(/\/$/, '') + selected.entry.path}</a> : <label>网址尾部 <input name="slug" maxlength="100" placeholder="自动生成" pattern="[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*" /></label>}</div>
            <section class="editor-panel" aria-label="正文编辑器">
              <div class="editor-top"><button type="button" class="button" id="add-media">添加媒体</button><div class="editor-tabs" role="tablist" aria-label="编辑模式"><button type="button" id="tab-visual" role="tab" aria-selected={originalFormat !== 'markdown'} aria-controls="visual-editor">可视化</button><button type="button" id="tab-source" role="tab" aria-selected={originalFormat === 'markdown'} aria-controls="entry-body">文本</button></div></div>
              <div id="source-toolbar" class="source-toolbar" hidden={originalFormat !== 'markdown'}><button type="button" data-wrap="strong">加粗</button><button type="button" data-wrap="em">斜体</button><button type="button" data-wrap="blockquote">引用</button><button type="button" data-wrap="code">代码</button><button type="button" data-wrap="link">链接</button><span id="source-format-label">{originalFormat === 'markdown' ? 'Markdown' : 'HTML'}</span></div>
              <div id="visual-editor" role="tabpanel"><textarea id="rich-body" aria-label="可视化正文" hidden={type === 'post'}>{initialHtml}</textarea>{type === 'post' && <div id="block-editor" />}</div>
              <label class="screen-reader-text" for="entry-body">正文源码</label><textarea id="entry-body" name="body" rows="22" maxlength="150000" spellcheck="false">{source}</textarea>
              <div class="editor-bottom"><span id="word-count">字数统计</span><span id="save-state" aria-live="polite">{selected?.draft ? '草稿' : selected ? '已发布' : '尚未保存'}</span></div>
            </section>
            {type === 'post' && <details class="postbox" open={Boolean(selected?.entry.excerpt)}><summary>摘要</summary><div class="inside"><label class="screen-reader-text" for="entry-excerpt">摘要</label><textarea id="entry-excerpt" name="excerpt" rows="4" maxlength="2000">{selected?.entry.excerpt ?? ''}</textarea></div></details>}
          </div>
          <aside class="edit-sidebar">
            <section class="postbox"><h2>发布</h2><div class="inside publishing">
              <div class="publish-actions"><button class="button" name="intent" value="draft">保存草稿</button><button type="button" class="button" id="preview-content">预览</button></div>
              <p>状态 <strong id="publication-state">{selected ? status(selected) : '草稿'}</strong></p>
              <label for="entry-visibility">可见性</label><select id="entry-visibility" name="visibility"><option value="public" selected={!selected?.entry.visibility}>公开</option><option value="password" selected={selected?.entry.visibility === 'password'}>密码保护</option><option value="private" selected={selected?.entry.visibility === 'private'}>私密（仅站主可见）</option></select>
              <div id="password-setting" hidden={selected?.entry.visibility !== 'password'}><label for="entry-password">密码</label><input id="entry-password" type="password" name="password" autocomplete="new-password" maxlength="512" placeholder={selected?.entry.passwordHash ? '留空保留原密码' : '设置查看密码'} /></div>
              <label for="publication-date">发布时间</label><input id="publication-date" type="datetime-local" />
            </div><div class="publish-footer"><span id="publish-hint">{live ? '修改后点击更新' : '准备好后即可发布'}</span><button class="button button-primary" id="publish-content" name="intent" value="publish">{live ? '更新' : '发布'}</button></div></section>
            {type === 'post' && <>
              <details class="postbox block-inspector" open><summary>区块设置</summary><div id="block-inspector-panel" /></details>
              <section class="postbox"><h2>分类目录</h2><div class="inside terms-list">{terms.category.length ? terms.category.map((term) => <label><input type="checkbox" name="category" value={term.id} checked={selected?.entry.categories?.includes(term.id)} />{term.name}</label>) : <p class="muted">暂无分类</p>}</div></section>
              <section class="postbox"><h2>标签</h2><div class="inside terms-list"><input type="hidden" name="tags_present" value="1" />{terms.post_tag.length ? terms.post_tag.map((term) => <label><input type="checkbox" name="tag" value={term.id} checked={selected?.entry.tags?.includes(term.id)} />{term.name}</label>) : <p class="muted">暂无标签</p>}</div></section>
              <section class="postbox"><h2>特色图片</h2><div class="inside"><img id="featured-preview" src={selected?.entry.featuredImage || undefined} alt="特色图片预览" hidden={!selected?.entry.featuredImage} /><input type="hidden" id="featured-image" name="featuredImage" value={selected?.entry.featuredImage ?? ''} /><button class="button-link" type="button" id="choose-featured">设置特色图片</button><button class="button-link" type="button" id="remove-featured" hidden={!selected?.entry.featuredImage}>移除特色图片</button></div></section>
            </>}
          </aside>
        </div>
      </form> : <>
        <div class="list-controls"><nav aria-label="内容状态">{[['all','全部'],['publish','已发布'],['draft','草稿'],['private','私密']].map(([key,text]) => <a class:list={{selected:filter===key}} href={base + (key==='all' ? '' : '&status='+key)}>{text} <span>（{key==='all' ? items.length : items.filter(item=>state(item)===key).length}）</span></a>)}</nav><form method="get"><input type="hidden" name="type" value={type}/><input type="hidden" name="status" value={filter}/><label class="screen-reader-text" for="content-search">搜索{label}</label><input id="content-search" name="s" value={search} /><button class="button">搜索{label}</button></form></div>
        <table class="content-table"><thead><tr><th scope="col">标题</th><th scope="col">状态</th><th scope="col">日期</th></tr></thead><tbody>{matching.slice((page-1)*20,page*20).map((record) => <tr><td><a class="row-title" href={base+'&id='+encodeURIComponent(String(record.entry.id))}>{record.entry.title || '（无标题）'}</a><div class="row-actions"><a href={base+'&id='+encodeURIComponent(String(record.entry.id))}>编辑</a>{publishedEditorialEntry(record) && <a href={record.entry.path} target="_blank" rel="noopener">查看</a>}</div></td><td>{status(record)}</td><td><time datetime={record.entry.published}>{new Date(record.entry.published).toLocaleString('zh-CN',{timeZone:site.timezone})}</time></td></tr>)}{!matching.length && <tr><td colspan="3">没有找到{label}。</td></tr>}</tbody></table>
        {count>1 && <nav class="pagination" aria-label="内容分页">{page>1 && <a class="button" href={base+'&'+new URLSearchParams({status:filter,s:search,page:String(page-1)})}>上一页</a>}<span>第 {page} / {count} 页</span>{page<count && <a class="button" href={base+'&'+new URLSearchParams({status:filter,s:search,page:String(page+1)})}>下一页</a>}</nav>}
      </>}
    </main>
    {editing && <>
      <dialog id="media-dialog" aria-labelledby="media-title"><div class="dialog-heading"><h2 id="media-title">添加媒体</h2><button type="button" class="button" data-close-dialog>关闭</button></div><div class="media-actions"><label class="button" for="media-upload">上传文件</label><input id="media-upload" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif,audio/mpeg,audio/ogg,video/mp4,application/pdf" multiple /><label>搜索媒体<input id="media-search" type="search" /></label></div><p id="media-message" role="status"></p><div id="media-grid" class="media-grid"></div><div class="media-url"><label for="media-url">从网址插入</label><input id="media-url" type="url" placeholder="https://" /><label for="media-alt">替代文本</label><input id="media-alt" /><button type="button" class="button button-primary" id="insert-media">插入</button></div></dialog>
      <dialog id="preview-dialog" aria-labelledby="preview-title"><div class="dialog-heading"><h2 id="preview-title">预览</h2><button type="button" class="button" data-close-dialog>关闭</button></div><iframe id="preview-frame" title="内容预览" sandbox="allow-same-origin"></iframe></dialog>
    </>}
  </body>
</html>
