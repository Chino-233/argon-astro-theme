---
import Layout from '../../layouts/ArgonLayout.astro';
import { authConfigured, isOwner, preventCaching, returnPath } from '../../lib/auth';
import { restrictedData } from '../../lib/private-store';
import { getEntries } from '../../lib/site';

preventCaching(Astro.response.headers);
const owner = isOwner(Astro.cookies);
const entries = await getEntries();
const restricted = owner ? (await restrictedData()).posts : [];
const configured = authConfigured();
const failed = Astro.url.searchParams.has('error');
const next = returnPath(Astro.url.searchParams.get('return'), '/auth/');
---
<Layout title={owner ? '私密内容' : '站主登录'} entries={entries} owner={owner} restricted>
  <article class="post card bg-white shadow-sm border-0 astro-form-card">
    <div class="card-body">
      <h1 class="post-title">{owner ? '私密内容' : '站主登录'}</h1>
      {owner ? <>
        <p><a class="btn btn-primary" href="/auth/argon/" data-astro-reload>Argon 设置</a></p>
        <p><a class="btn btn-outline-primary" href="/auth/comments/" data-astro-reload>留言审核</a></p>
        <ul class="astro-private-list">{restricted.map((entry) => <li><a href={entry.path}>{entry.title}</a> <span class="badge badge-secondary">{entry.visibility === 'password' ? '密码保护' : '私密'}</span></li>)}</ul>
        {!restricted.length && <p>暂无私密内容。</p>}
        <form action="/auth/action/" method="post" data-astro-reload><input type="hidden" name="intent" value="logout" /><button class="btn btn-outline-primary" type="submit">退出</button></form>
      </> : configured ? <>
        {failed && <p role="alert">密码不正确。</p>}
        <form action="/auth/action/" method="post" data-astro-reload>
          <input type="hidden" name="intent" value="login" /><input type="hidden" name="return" value={next} />
          <label for="owner-password">站主密码</label>
          <input id="owner-password" class="form-control" type="password" name="password" autocomplete="current-password" maxlength="512" required />
          <button class="btn btn-primary mt-3" type="submit">登录</button>
        </form>
      </> : <p>站主登录尚未配置。</p>}
    </div>
  </article>
</Layout>
