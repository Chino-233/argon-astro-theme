---
import { isOwner, preventCaching } from '../../../lib/auth';
import { metadataChoices, optionGroups } from '../../../lib/argon-options';
import { customCss, siteOptions } from '../../../lib/site';
import { commentMailConfigured } from '../../../lib/comment-mail';

preventCaching(Astro.response.headers);
if (!isOwner(Astro.cookies)) {
  Astro.response.headers.set('Location', '/auth/?return=%2Fauth%2Fargon%2F');
  return new Response(null, { status: 303, headers: Astro.response.headers });
}
const option = siteOptions(Astro.locals.argonOverrides);
const fieldValue = (key: string, fallback: string) => Astro.locals.argonOverrides['argon_' + key] ?? (key === 'custom_css' ? customCss : option(key, fallback));
const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error')?.slice(0, 200);
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Argon 设置</title>
    <link rel="stylesheet" href="/assets/argon/argon_css_merged.css" />
    <style>
      body { margin: 0; background: #f5f7fb; color: #20283b; }
      .admin-shell { max-width: 1040px; margin: auto; padding: 32px 20px 60px; }
      .admin-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
      .admin-header h1 { color: #182037; font-size: 2rem; margin: 0; }
      .admin-header a { margin-left: 12px; }
      .admin-nav { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 18px 0; }
      .admin-section { border: 1px solid #e5e9f2; background: white; border-radius: 8px; margin: 0 0 16px; padding: 20px; scroll-margin: 16px; }
      .admin-section h2 { font-size: 1.2rem; color: #182037; margin-bottom: 16px; }
      .fields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px 20px; }
      label { display: block; color: #2a3550; font-weight: 600; margin: 0; }
      input, select, textarea { margin-top: 4px; }
      input[type="color"] { padding: 5px 10px; width: 112px; }
      .save-bar { position: sticky; bottom: 0; z-index: 1; padding: 12px 0; background: #f5f7fb; }
      @media (max-width: 580px) { .fields { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main class="admin-shell">
      <header class="admin-header">
        <h1>Argon 设置</h1>
        <div><a href="/auth/">站主管理</a><a href="/">查看站点</a></div>
      </header>
      <nav class="admin-nav" aria-label="设置分组">
        {optionGroups.map((group, index) => <a href={'#group-' + index}>{group.title}</a>)}
        <a href="#backup">导入与导出</a>
      </nav>
      {saved && <p class="alert alert-success" role="status">{saved === 'import' ? '已导入并保存支持的设置。' : 'Argon 设置已保存。'}</p>}
      {error && <p class="alert alert-danger" role="alert">{error}</p>}
      <form action="/auth/argon/save/" method="post">
        <input type="hidden" name="action" value="save" />
        {optionGroups.map((group, index) => <section class="admin-section" id={'group-' + index}>
          <h2>{group.title}</h2>
          {group.title === '评论与留言' && !commentMailConfigured() && <p class="text-muted">邮件回复通知需要在服务器上配置 SMTP。设置可以提前保存。</p>}
          <div class="fields">
            {group.fields.map((field) => {
              const name = 'argon_' + field.key;
              const current = fieldValue(field.key, field.default);
              const multiline = field.type === 'html' || field.type === 'css';
              return <label style={multiline ? 'grid-column:1/-1' : undefined}>
                {field.label}
                {field.type === 'select'
                  ? <select class="form-control" name={name}>
                      {field.choices?.map(([value, label]) => <option value={value} selected={value === current}>{label}</option>)}
                    </select>
                  : multiline ? <textarea class="form-control" name={name} rows="5" maxlength="16384">{current}</textarea>
                  : <input class="form-control" name={name} value={current} type={field.type === 'url' || field.type === 'metadata' ? 'text' : field.type}
                      min={field.min} max={field.max} step={field.step} maxlength="2048" inputmode={field.type === 'url' ? 'url' : undefined} />
                }
                {field.type === 'metadata' && <small class="form-text text-muted">用 | 分隔。{metadataChoices.map(([key, label]) => key + ' ' + label).join('、')}。</small>}
              </label>;
            })}
          </div>
        </section>)}
        <div class="save-bar"><button class="btn btn-primary" type="submit">保存设置</button></div>
      </form>
      <section class="admin-section" id="backup">
        <h2>导入与导出</h2>
        <p><a class="btn btn-outline-primary btn-sm" href="/auth/argon/config.json" download="argon-settings.json">导出当前设置</a></p>
        <form action="/auth/argon/save/" method="post">
          <input type="hidden" name="action" value="import" />
          <label>粘贴 Argon 设置 JSON<textarea class="form-control" name="settings" rows="5" maxlength="65536" required></textarea></label>
          <p class="text-muted mt-2 mb-2">导入会更新此页面支持的字段。建议先导出当前设置。</p>
          <button class="btn btn-outline-primary" type="submit">导入并保存</button>
        </form>
      </section>
    </main>
  </body>
</html>
