---
import Layout from '../../../layouts/ArgonLayout.astro';
import EntryHeader from '../../../components/EntryHeader.astro';
import TalkCard from '../../../components/TalkCard.astro';
import { isOwner, preventCaching } from '../../../lib/auth';
import { editEntry, ownerEntries } from '../../../lib/editor';
import { getEntries } from '../../../lib/site';

preventCaching(Astro.response.headers);
if (Astro.request.method !== 'POST' || !isOwner(Astro.cookies) || Astro.request.headers.get('Origin') !== Astro.url.origin) return new Response(null, {status:403, headers:Astro.response.headers});
if (!Astro.request.headers.get('Content-Type')?.startsWith('application/x-www-form-urlencoded') || Number(Astro.request.headers.get('Content-Length') ?? 0) > 1500000) return new Response(null, {status:413, headers:Astro.response.headers});
const body = await Astro.request.text();
if (body.length > 1500000) return new Response(null, {status:413, headers:Astro.response.headers});
const form = new URLSearchParams(body);
form.set('intent', 'draft');
let record;
try { record = await editEntry(form, await ownerEntries()); }
catch (error) { return new Response(error instanceof Error ? error.message : '无法预览', {status:400, headers:Astro.response.headers}); }
const entry = record.entry;
---
<Layout title={'预览 · ' + entry.title} entries={await getEntries()} owner restricted>
  <p class="alert alert-info" role="status">预览 · 尚未发布的修改</p>
  {entry.type === 'shuoshuo' ? <TalkCard entry={entry} comments={[]} unlocked /> : <article class="post post-full card bg-white shadow-sm border-0"><EntryHeader entry={entry} /><div class="post-content" data-article set:html={entry.html} /></article>}
</Layout>
