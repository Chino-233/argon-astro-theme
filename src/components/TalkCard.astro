---
import { stamp, stripTags } from '../lib/site';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Comment, Entry } from '../lib/types';
import TalkBody from './TalkBody.astro';

interface Props { entry: Entry; comments: Comment[]; extraLikes?: number; preview?: boolean; allowReply?: boolean; unlocked?: boolean; bodyComponent?: AstroComponentFactory }
const { entry, comments, extraLikes = 0, preview = false, allowReply = false, unlocked = false, bodyComponent: Body } = Astro.props;
const date = stamp(entry.published);
const locked = entry.visibility === 'password' && !unlocked;
const liked = (Astro.cookies.get('argon_talk_likes')?.value ?? '').split(',').includes(String(entry.id));
const returnTo = preview ? Astro.url.pathname + '#post-' + entry.id : entry.path;
---
<div class="shuoshuo-container">
  <div class="shuoshuo-meta shadow-sm">
    <time datetime={entry.published}>
      <i class="fa fa-calendar-o" aria-hidden="true"></i>
      <span class="shuoshuo-date-month">{Number(date.month)}</span> 月 <span class="shuoshuo-date-date">{date.day}</span> 日 ,
      <span class="shuoshuo-date-year">{date.year}</span>
      <span class="post-meta-devide">|</span>
      <i class="fa fa-clock-o" aria-hidden="true"></i> <span class="shuoshuo-date-time">{date.time + ':' + String(new Date(entry.published).getUTCSeconds()).padStart(2, '0')}</span>
    </time>
  </div>
  <article id={'post-' + entry.id} class:list={['card shuoshuo-main bg-white shadow-sm border-0', { 'shuoshuo-foldable': preview }]}>
    <a class="shuoshuo-title" href={entry.path}>{locked ? '密码保护：' + entry.title : entry.title}</a>
    {locked ? <div class="shuoshuo-content"><p>此内容受密码保护。</p><a href={entry.path}>输入密码查看</a></div>
      : <TalkBody html={entry.html} preview={preview} bodyComponent={Body} />}
    {preview && comments.length > 0 && !locked && <ul class="shuoshuo-comments pl-0 mb-0">
      {comments.slice(0, 3).map((comment) => <li>
        <a class="shuoshuo-comment-item-title" href={entry.path + '#comment-' + comment.id}>{comment.author || '匿名'}：</a>
        {stripTags(comment.html).slice(0, 100)}
      </li>)}
    </ul>}
    {!entry.visibility && <div class="shuoshuo-operations astro-talk-operations">
      {preview && allowReply && <a class="btn btn-icon btn-outline-primary btn-sm" href={entry.path + '#post_comment'}>
        <i class="fa fa-comments-o" aria-hidden="true"></i> {comments.length || '评论'}
      </a>}
      <form action="/interactions/" method="post" data-astro-reload>
        <input type="hidden" name="action" value="like" />
        <input type="hidden" name="entry" value={entry.id} />
        <input type="hidden" name="return" value={returnTo} />
        <button class:list={['shuoshuo-upvote btn btn-icon btn-outline-primary btn-sm', { upvoted: liked }]} type="submit" disabled={liked} aria-label={liked ? '已点赞' : '点赞'}>
          <i class={liked ? 'fa fa-thumbs-up' : 'fa fa-thumbs-o-up'} aria-hidden="true"></i>
          <span class="shuoshuo-upvote-num">{(entry.likes ?? 0) + extraLikes}</span>
        </button>
      </form>
    </div>}
  </article>
</div>
