---
import { menus, safeLink, site, siteOptions } from '../lib/site';
import { flattenMenu, hasMenuPage, menuTree } from '../lib/navigation';
import MenuLink from './MenuLink.astro';

const items = menuTree(menus.toolbar_menu ?? []);
const option = siteOptions(Astro.locals.argonOverrides);
const icon = option('toolbar_icon');
---
<div id="toolbar">
  <header class="header-global">
    <nav id="navbar-main" class="navbar navbar-main navbar-expand-lg navbar-transparent navbar-light bg-primary headroom--pinned navbar-ontop">
      <div class="container">
        <button id="open_sidebar" class="navbar-toggler" type="button" aria-expanded="false" aria-controls="leftbar" aria-label="打开侧栏">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-brand mr-0">
          {icon && <a class="navbar-brand navbar-icon mr-lg-2" href={safeLink(option('toolbar_icon_link', '/'))}><img src={safeLink(icon)} alt={site.title} /></a>}
          <a class="navbar-brand navbar-title" href="/">{option('toolbar_title', site.title)}</a>
        </div>
        <div class="navbar-collapse collapse" id="navbar_global">
          <ul class="navbar-nav navbar-nav-hover align-items-lg-center">
            {items.map((item) => <li class:list={['nav-item', { 'argon-menu-active': hasMenuPage(item, Astro.url) }]}>
              {item.children.length ? <details class="argon-toolbar-menu">
                <summary class="nav-link"><span set:html={item.title} /><i class="fa fa-angle-down" aria-hidden="true"></i></summary>
                <div class="dropdown-menu">
                  {item.url && item.url !== '#' && <MenuLink node={item} class="dropdown-item" />}
                  {item.children.map((group) => group.children.length ? <details class="argon-toolbar-group" name={'toolbar-group-' + item.id} open={hasMenuPage(group, Astro.url)}>
                    <summary class="dropdown-item"><span set:html={group.title} /><i class="fa fa-angle-down" aria-hidden="true"></i></summary>
                    <div class="argon-toolbar-group-panel">
                      {group.url && group.url !== '#' && <MenuLink node={group} class="dropdown-item" />}
                      {flattenMenu(group.children).map((node) => <MenuLink node={node} class="dropdown-item" />)}
                    </div>
                  </details> : <MenuLink node={group} class="dropdown-item" />)}
                </div>
              </details> : <MenuLink node={item} class="nav-link" />}
            </li>)}
          </ul>
          <ul class="navbar-nav align-items-lg-center ml-lg-auto">
            <li id="navbar_search_container" class="nav-item">
              <form id="navbar_search_input_container" action="/" method="get" data-astro-reload>
                <div class="input-group input-group-alternative">
                  <span class="input-group-prepend"><button type="submit" class="input-group-text" data-desktop-search aria-controls="navbar_search_input" aria-expanded="false" aria-label="打开搜索"><i class="fa fa-search" aria-hidden="true"></i></button></span>
                  <input id="navbar_search_input" class="form-control" name="s" placeholder="搜索什么..." aria-label="搜索" autocomplete="off" required />
                </div>
              </form>
            </li>
          </ul>
        </div>
        <button class="navbar-toggler d-lg-none" type="button" data-open-dialog="argon_search_modal" aria-label="搜索"><i class="fa fa-search" aria-hidden="true"></i></button>
      </div>
    </nav>
  </header>
</div>
<dialog id="argon_search_modal" class="argon-dialog">
  <div class="card-body">
    <div class="argon-dialog-title"><h5>搜索</h5><button type="button" class="argon-close" data-close-dialog aria-label="关闭">×</button></div>
    <form action="/" method="get" data-astro-reload>
      <div class="input-group">
        <input class="form-control" name="s" placeholder="搜索什么..." aria-label="搜索" autocomplete="off" required />
        <button class="btn btn-primary" type="submit">搜索</button>
      </div>
    </form>
  </div>
</dialog>
