---
import type { Entry } from '../lib/types';

const { entry, guestbook = false } = Astro.props as { entry: Entry; guestbook?: boolean };
const result = Astro.url.searchParams.get('comment');
const message = result === 'pending' ? '已提交，站主审核通过后会显示。'
  : result === 'invalid' ? '请检查留言内容、昵称或网站地址。'
  : result === 'rate' ? '提交太快了，请稍后再试。' : '';
---
<section id="post_comment" class="card shadow-sm border-0">
  <div class="card-body">
    <h2 class="post-comment-title"><i class="fa fa-commenting" aria-hidden="true"></i> {guestbook ? '发送留言' : '发送评论'}</h2>
    {message && <p class:list={['alert', result === 'pending' ? 'alert-success' : 'alert-warning']} role="status">{message}</p>}
    <div class="post-comment-reply astro-reply-info" data-comment-reply-info hidden>
      正在回复 <strong data-comment-reply-name></strong>
      <button type="button" class="btn btn-outline-primary btn-sm" data-comment-reply-cancel>取消回复</button>
    </div>
    <form action="/interactions/" method="post" data-astro-reload>
      <input type="hidden" name="action" value="comment" />
      <input type="hidden" name="entry" value={entry.id} />
      <input type="hidden" name="parent" value="0" data-comment-parent />
      <label class="sr-only" for="post_comment_content">留言内容</label>
      <textarea id="post_comment_content" class="form-control form-control-alternative" name="comment" placeholder={guestbook ? '留言内容' : '评论内容'} rows="4" maxlength="4000" required></textarea>
      <div class="row mt-3">
        <div class="col-sm-6 mb-2"><label class="sr-only" for="post_comment_name">昵称</label><input id="post_comment_name" class="form-control" name="author" placeholder="昵称（选填）" maxlength="60" autocomplete="nickname" /></div>
        <div class="col-sm-6 mb-2"><label class="sr-only" for="post_comment_link">网站</label><input id="post_comment_link" class="form-control" name="website" type="url" placeholder="网站（选填）" maxlength="500" /></div>
      </div>
      <div class="text-right mt-2"><button id="post_comment_send" class="btn btn-icon btn-primary" type="submit"><i class="fa fa-paper-plane" aria-hidden="true"></i> 发送</button></div>
    </form>
  </div>
</section>
