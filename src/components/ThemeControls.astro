---
import { siteOptions } from '../lib/site';
const option = siteOptions(Astro.locals.argonOverrides);
const { showProgress = false, commentTarget } = Astro.props;
const settings = option('fab_show_settings_button', 'true') !== 'false';
---
<div id="float_action_buttons" class="float-action-buttons">
  {settings && <button id="fabtn_toggle_blog_settings_popup" class="btn btn-icon btn-neutral fabtn shadow-sm" type="button" data-open-dialog="theme_preferences" title="博客设置" aria-label="博客设置"><i class="fa fa-cog" aria-hidden="true"></i></button>}
  {option('fab_show_darkmode_button') === 'true' && <button id="fabtn_toggle_darkmode" class="btn btn-icon btn-neutral fabtn shadow-sm" type="button" data-toggle-dark title="切换夜间模式" aria-label="切换夜间模式"><i class="fa fa-moon-o" aria-hidden="true"></i></button>}
  {commentTarget && option('fab_show_gotocomment_button') === 'true' && <a id="fabtn_go_to_comment" href={commentTarget} class="btn btn-icon btn-neutral fabtn shadow-sm" title="评论" aria-label="评论"><i class="fa fa-comments" aria-hidden="true"></i></a>}
  {showProgress && <button id="fabtn_reading_progress" class="btn btn-icon btn-neutral fabtn shadow-sm" type="button" data-back-top title="阅读进度"><span id="fabtn_reading_progress_bar"></span><span id="fabtn_reading_progress_details">0%</span></button>}
  <button id="fabtn_back_to_top" class="btn btn-icon btn-neutral fabtn shadow-sm" type="button" data-back-top title="回到顶部" aria-label="回到顶部"><i class="fa fa-chevron-up" aria-hidden="true"></i></button>
</div>
{settings && <dialog id="theme_preferences" class="argon-dialog">
  <div class="card-body theme-preferences">
    <div class="argon-dialog-title"><h5>博客设置</h5><button class="argon-close" type="button" data-close-dialog aria-label="关闭">×</button></div>
    <label>外观<select name="mode" data-pref class="form-control"><option value="light">日间</option><option value="dark">夜间</option>{option('enable_amoled_dark') === 'true' && <option value="black">纯黑</option>}<option value="system">跟随系统</option></select></label>
    <label>字体<select name="font" data-pref class="form-control"><option value="sans-serif">Sans Serif</option><option value="serif">Serif</option></select></label>
    <label>阴影<select name="shadow" data-pref class="form-control"><option value="default">默认</option><option value="small">浅阴影</option><option value="big">深阴影</option></select></label>
    <label>滤镜<select name="filter" data-pref class="form-control"><option value="off">关闭</option><option value="sunset">日落</option><option value="darkness">暗化</option><option value="grayscale">灰度</option></select></label>
    <label>圆角<input name="radius" data-pref type="range" min="0" max="30" step="0.5" value={option('card_radius', '4')} /></label>
    {option('show_customize_theme_color_picker') === 'true' && <label>主题色<input name="color" data-pref type="color" value={option('theme_color', '#5e72e4')} /></label>}
  </div>
</dialog>}
