---
import { articleStats, siteOptions, stamp, terms } from '../lib/site';
import type { Entry } from '../lib/types';

const { entry, readStats = true, commentCount = 0 } = Astro.props as { entry: Entry; readStats?: boolean; commentCount?: number };
const option = siteOptions(Astro.locals.argonOverrides);
const date = stamp(entry.published);
const updated = entry.updated ? stamp(entry.updated) : null;
const cats = terms.category.filter((term) => entry.categories?.includes(term.id));
const format = option('dateformat', 'YMD');
const pretty = (value: typeof date) => {
  const day = String(Number(value.day));
  const month = String(Number(value.month));
  const dates = format === 'MDY' ? [month, day, value.year] : format === 'DMY' ? [day, month, value.year] : [value.year, month, day];
  return dates.join('-') + ' ' + value.time.replace(/^0/, '');
};
const fields = (Astro.locals.argonOverrides.argon_article_meta ?? option('article_meta', 'time|views|categories|edittime')).split('|');
const count = entry.views == null ? NaN : Number(String(entry.views).replaceAll(',', ''));
const visible = fields.filter((key) => (
  key === 'time' || (key === 'views' && Number.isFinite(count)) || (key === 'edittime' && updated) ||
  (key === 'categories' && cats.length) || (key === 'author' && entry.author) ||
  (key === 'comments' && commentCount)
));
const showStats = readStats && option('show_readingtime', 'true') !== 'false';
const speeds = [Number(option('reading_speed', '300')), Number(option('reading_speed_en', '160')), Number(option('reading_speed_code', '20'))] as const;
const stats = showStats ? articleStats(entry, speeds) : { words: 0, minutes: 0 };
const useImportedTime = speeds[0] === 300 && speeds[1] === 160 && speeds[2] === 20;
const minutes = (useImportedTime ? entry.readingTime : undefined) ?? (
  stats.minutes < .3 ? '几秒读完' : stats.minutes < 1 ? '1 分钟内' : Math.ceil(stats.minutes) + ' 分钟'
);
---
{(visible.length > 0 || showStats) && <div class="post-meta">
  {visible.map((key, index) => <>
    {index > 0 && <span class="post-meta-devide">|</span>}
    <div class={'post-meta-detail post-meta-detail-' + key}>
      {key === 'time' && <><i class="fa fa-clock-o" aria-hidden="true"></i> <time datetime={entry.published}>{pretty(date)}</time></>}
      {key === 'views' && <><i class="fa fa-eye" aria-hidden="true"></i> <span title="浏览量">{new Intl.NumberFormat('en-US').format(count)}</span></>}
      {key === 'edittime' && updated && <><i class="fa fa-clock-o" aria-hidden="true"></i> <time datetime={entry.updated}>{pretty(updated)}</time></>}
      {key === 'categories' && <><i class="fa fa-bookmark-o" aria-hidden="true"></i> {cats.map((term) => <a class="post-meta-detail-catagory-link" href={term.url}>{term.name}</a>)}</>}
      {key === 'author' && <><i class="fa fa-user-o" aria-hidden="true"></i> {entry.author}</>}
      {key === 'comments' && <><i class="fa fa-comment-o" aria-hidden="true"></i> {commentCount}</>}
    </div>
  </>)}
  {showStats && <>
    {visible.length > 0 && <br />}
    <div class="post-meta-detail post-meta-detail-words"><i class="fa fa-file-word-o" aria-hidden="true"></i> {entry.wordCount ?? stats.words} 字</div>
    <span class="post-meta-devide">|</span>
    <div class="post-meta-detail post-meta-detail-words"><i class="fa fa-hourglass-end" aria-hidden="true"></i> {minutes}</div>
  </>}
</div>}
