---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/ArgonLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import EntryHeader from '../components/EntryHeader.astro';
import CommentList from '../components/CommentList.astro';
import CommentForm from '../components/CommentForm.astro';
import TalkCard from '../components/TalkCard.astro';
import Pagination from '../components/Pagination.astro';
import Timeline from '../components/Timeline.astro';
import ShareLinks from '../components/ShareLinks.astro';
import OutdatedNotice from '../components/OutdatedNotice.astro';
import FriendLinks from '../components/FriendLinks.astro';
import { customHtml } from '../lib/argon-options';
import { firstImage, relatedArticles } from '../lib/argon-features';
import { canRead, isOwner, preventCaching } from '../lib/auth';
import { findRestricted, restrictedData } from '../lib/private-store';
import { allowsComments, commentVisitor, loadInteractions, ownsComment, publicComments } from '../lib/interactions';
import { canonicalPath, comments, getEntries, headings, ordered, searchTypes, site, siteOptions, stamp, stripTags, terms } from '../lib/site';
import type { Entry, Heading } from '../lib/types';

const entries = await getEntries();
const route = canonicalPath(Astro.url.pathname);
const owner = isOwner(Astro.cookies);
const search = Astro.url.searchParams;
const option = siteOptions(Astro.locals.argonOverrides);
const legacy = route === '/' ? (search.get('p') ?? search.get('page_id')) : null;
const legacyId = legacy && /^\d+$/.test(legacy) ? legacy : null;
const restricted = await restrictedData();
const privateEntry = findRestricted(restricted, route, legacyId);
const publicEntry = entries.find((item) => canonicalPath(item.path) === route || (legacyId && String(item.id) === legacyId));
const allowed = privateEntry ? canRead(privateEntry, Astro.cookies) : false;
const passwordPage = Boolean(privateEntry?.visibility === 'password' && !allowed);
const missingPrivate = Boolean(privateEntry?.visibility === 'private' && !allowed);
const entry = privateEntry ? (allowed || passwordPage ? privateEntry : undefined) : publicEntry;
if (owner || privateEntry || route.startsWith('/auth/')) preventCaching(Astro.response.headers);
if (entry && legacyId && !privateEntry) return Astro.redirect(entry.path, 301);

const baseRoute = route.replace(/\/page\/(\d+)\/$/, '/');
const page = Number(route.match(/\/page\/(\d+)\/$/)?.[1] ?? 1);
const pageSize = Math.max(1, site.posts_per_page);
const home = baseRoute === '/' && !search.has('s') && !legacyId;
const term = [...terms.category, ...terms.post_tag].find((item) => canonicalPath(item.url) === baseRoute);
const archive = baseRoute.match(/^\/(\d{4})(?:\/(\d{2})(?:\/(\d{2}))?)?\/$/);
const searchPage = baseRoute === '/' && search.has('s');
const query = search.get('s')?.trim().slice(0, 200) ?? '';
const typeLabels = new Map<string, string>([['post', '文章'], ['page', '页面'], ['shuoshuo', '说说'], ...Object.entries(searchTypes)]);
for (const item of entries) if (item.searchType && !typeLabels.has(item.searchType)) typeLabels.set(item.searchType, item.searchType);
const supported = [...typeLabels.keys()];
const filterConfig = option('search_filters_type', '*post,*page,shuoshuo').split(',').map((value) => value.trim());
const availableTypes = [...new Set(filterConfig.flatMap((value) => {
  const type = supported.find((candidate) => value === candidate || value === '*' + candidate);
  return type ? [type] : [];
}))];
const defaultTypes = availableTypes.filter((type) => filterConfig.includes('*' + type));
const searchFilters = option('enable_search_filters', 'true') === 'true' && availableTypes.length > 0;
const chosen = search.get('post_type')?.split(',') ?? search.getAll('type');
const filtersSubmitted = search.has('post_type') || search.has('filter');
const types = !searchFilters ? supported : (filtersSubmitted || chosen.length) ? availableTypes.filter((type) => chosen.includes(type))
  : defaultTypes.length ? defaultTypes : availableTypes;
const publicPreviews = ordered([...entries, ...restricted.posts.filter((item) => item.visibility === 'password').map((item) => ({
  id: item.id, type: item.type, title: item.title, path: item.path, published: item.published,
  excerpt: '', html: '', visibility: 'password' as const,
}))]);
const articles = publicPreviews.filter((item) => item.type === 'post');
const hiddenCategories = new Set(option('hide_categories').split(',').filter(Boolean).map(Number));
const talks = publicPreviews.filter((item) => item.type === 'shuoshuo');
const talkPage = entry?.template === 'shuoshuo.php' || (!entry && route === '/shuoshuo/');
const timeline = entry?.template === 'timeline.php' || (!entry && route === '/archive/');
const showArchiveMonth = option('archives_timeline_show_month', 'true') === 'true';
const archiveHeadings = new Map<string, Heading>();
if (timeline) {
  for (const entry of articles) {
    const { year, month } = stamp(entry.published);
    const yearId = 'archive-' + year;
    const monthId = yearId + '-' + month;
    if (!archiveHeadings.has(yearId)) archiveHeadings.set(yearId, { id: yearId, label: year + ' 年', depth: 2 });
    if (showArchiveMonth && !archiveHeadings.has(monthId)) archiveHeadings.set(monthId, { id: monthId, label: month + ' 月', depth: 3 });
  }
}
const guestbook = entry?.template === 'msgboard.php';
if (talkPage || entry?.type === 'shuoshuo') Astro.response.headers.set('Vary', 'Cookie');
const list = !entry && (home || Boolean(term || archive || searchPage));
const matching = list ? (
  searchPage ? entries.filter((item) => types.includes(item.searchType ?? item.type) && query && query.toLocaleLowerCase().split(/\s+/).every((word) =>
    (item.title + ' ' + stripTags(item.html)).normalize('NFC').toLocaleLowerCase().includes(word.normalize('NFC'))))
  : term ? entries.filter((item) => (item.categories?.includes(term.id) || item.tags?.includes(term.id)))
  : archive ? articles.filter((item) => {
      const date = stamp(item.published);
      return date.year === archive[1] && (!archive[2] || date.month.padStart(2, '0') === archive[2]) &&
        (!archive[3] || date.day.padStart(2, '0') === archive[3]);
    })
  : publicPreviews.filter((item) => (item.type === 'post' && !item.categories?.some((id) => hiddenCategories.has(id))) ||
    (item.type === 'shuoshuo' && option('home_show_shuoshuo', 'true') === 'true'))
) : [];
const total = Math.max(1, Math.ceil(matching.length / pageSize));
const found = !missingPrivate && Boolean(entry || talkPage || timeline || (list && page >= 1 && page <= total));
if (!found) {
  Astro.response.status = 404;
  preventCaching(Astro.response.headers);
}
const displayed = matching.slice((page - 1) * pageSize, page * pageSize);
const entryTitle = passwordPage ? '密码保护：' + entry?.title : entry?.title;
const title = !found ? '找不到页面' : entryTitle ?? (searchPage ? '搜索结果' : term?.name ?? (archive ? '归档 ' + archive.slice(1).filter(Boolean).join('年').replace(/年(\d\d)年/, '年$1月') : talkPage ? '碎碎念' : timeline ? '归档' : undefined));
const markdown = entry && !passwordPage && typeof entry.id === 'string' ? await getEntry('posts', entry.id) : undefined;
const rendered = markdown ? await render(markdown) : undefined;
const Content = rendered?.Content;
const article = entry && !passwordPage && !rendered
  ? headings(entry.html, 'post-' + entry.id)
  : { html: '', links: rendered?.headings.map(({ slug, text, depth }) => ({ id: slug, label: text, depth })) ?? [] };
const interactions = await loadInteractions();
const visitor = commentVisitor(Astro.cookies);
if (entry && allowsComments(entry)) {
  if (visitor) preventCaching(Astro.response.headers);
  else Astro.response.headers.set('Vary', 'Cookie');
}
const allComments = [...comments, ...publicComments(interactions)];
const commentsFor = (id: Entry['id']) => allComments.filter((item) => item.post_id === id);
const visibleComments = entry && !passwordPage ? [
  ...commentsFor(entry.id),
  ...interactions.comments.filter((item) => item.post_id === entry.id && (item.ownerOnly || item.status === 'pending') &&
    (owner || ownsComment(item, visitor))),
  ...restricted.comments.filter((item) => item.post_id === entry.id && (!item.ownerOnly || owner)),
] : [];
const canComment = Boolean(entry && !passwordPage && allowsComments(entry));
const likesFor = (id: Entry['id']) => interactions.likes[String(id)] ?? 0;
const isArticle = entry?.type === 'post';
const related = entry ? relatedArticles(entry, articles, option) : [];
const shareMode = option('show_sharebtn', 'domestic');
const donate = option('donate_qrcode_url');
const afterPost = isArticle ? customHtml('custom_html_foot', option('additional_content_after_post')) : '';
const querySuffix = searchPage ? '?s=' + encodeURIComponent(query) + '&post_type=' + types.join(',') : '';
const bannerImage = entry && !passwordPage && option('show_thumbnail_in_banner_in_content_page') === 'true' ? firstImage(entry, option) : undefined;
---
<Layout title={title} entries={entries} owner={owner} restricted={Boolean(privateEntry) || !found}
  home={home && found} list={list && found} progress={Boolean(entry && entry.type !== 'shuoshuo' && !passwordPage && !talkPage && !timeline && !guestbook)}
  commentTarget={canComment ? '#post_comment' : visibleComments.length ? '#comments' : undefined}
  socialImage={entry && !entry.visibility ? firstImage(entry, option) : undefined} socialType={isArticle ? 'article' : 'website'}
  headings={timeline ? [...archiveHeadings.values()] : guestbook || entry?.type === 'shuoshuo' ? [] : article.links} bannerImage={bannerImage} description={entry && !privateEntry ? stripTags(entry.excerpt) : undefined}>
  <div slot="information" class="page-information-card-container">
    {found && (talkPage || (list && !home)) && <div class="page-information-card card bg-gradient-secondary shadow-lg border-0"><div class="card-body">
      {searchPage ? <><h1 class="h3 text-black mr-2 d-inline-block">{query || '搜索'}</h1>
        <p class="lead text-black mt-0 d-inline-block">的搜索结果</p></> :
        <h1 class="page-information-card-title h3 text-black">{talkPage ? '说说' : title}</h1>}
      {talkPage && <p class="text-black mt-3 mb-0 opacity-8"><i class="fa fa-quote-left mr-1" aria-hidden="true"></i> {talks.length} 条说说</p>}
      {term?.description && <p class="text-black mt-3 mb-0">{term.description}</p>}
      {!talkPage && !searchPage && <p class="text-black mt-3 mb-0 opacity-8">{matching.length} 篇文章</p>}
      {searchPage && searchFilters && <form action="/" method="get" data-astro-reload class="search-filters" data-search-filters>
        <input type="hidden" name="s" value={query} />
        <input type="hidden" name="filter" value="1" />
        {availableTypes.map((type) => <div class="custom-control custom-checkbox search-filter-wrapper">
          <input id={'search_filter_' + type} name="type" value={type} class="custom-control-input search-filter" type="checkbox" checked={types.includes(type)} />
          <label class="custom-control-label" for={'search_filter_' + type}>{typeLabels.get(type)}</label>
        </div>)}
        <noscript><button class="btn btn-sm btn-outline-primary" type="submit">筛选</button></noscript>
      </form>}
      {searchPage && <p class="text-black mt-3 mb-0 opacity-8"><i class="fa fa-file-o mr-1" aria-hidden="true"></i> {matching.length} 个结果</p>}
    </div></div>}
  </div>
  {!found ? <article class="post card bg-white shadow-sm border-0"><div class="card-body">
    <h1 class="post-title">找不到页面</h1><a class="btn btn-outline-primary mt-3" href="/">返回首页</a>
  </div></article> : passwordPage && entry ? <article class="post card bg-white shadow-sm border-0 astro-form-card"><div class="card-body">
    <h1 class="post-title">{entryTitle}</h1><p>此内容受密码保护。</p>
    {search.has('error') && <p role="alert">密码不正确。</p>}
    <form action="/auth/action/" method="post" data-astro-reload>
      <input type="hidden" name="intent" value="unlock" /><input type="hidden" name="id" value={entry.id} />
      <label for="entry-password">文章密码</label><input id="entry-password" class="form-control" type="password" name="password" maxlength="512" required />
      <button class="btn btn-primary mt-3" type="submit">查看内容</button>
    </form>
  </div></article> : talkPage ? <>
    {talks.map((item) => <TalkCard entry={item} preview comments={commentsFor(item.id)} extraLikes={likesFor(item.id)} allowReply={allowsComments(item)} />)}
  </> : timeline ? <article class="post post-full card bg-white shadow-sm border-0">
    {entry ? <EntryHeader entry={entry} readStats={false} bannerCover={Boolean(bannerImage)} /> : <header class="post-header text-center"><h1 class="astro-entry-title">{title}</h1></header>}
    <div class="post-content" data-article><Timeline entries={articles} showMonth={showArchiveMonth} /></div>
  </article> : entry ? <>
    {entry.type === 'shuoshuo' ? <TalkCard entry={{ ...entry, html: article.html || entry.html }} bodyComponent={Content} comments={visibleComments} extraLikes={likesFor(entry.id)} unlocked={allowed} /> : !guestbook && <article class="post post-full card bg-white shadow-sm border-0" id={'post-' + entry.id}>
      <EntryHeader entry={entry} commentCount={visibleComments.length} bannerCover={Boolean(bannerImage)} />
      <div class="post-content" id="post_content" data-article>
        {isArticle && <OutdatedNotice entry={entry} />}
        {Content ? <Content /> : <Fragment set:html={article.html} />}
        {entry.template === 'friendlinks' && <FriendLinks style={entry.linkStyle} />}
        {afterPost && <div class="astro-after-post" set:html={afterPost} />}
      </div>
      {isArticle && <div class="astro-article-footer">
        {(entry.tags?.length ?? 0) > 0 && terms.post_tag.filter((term) => entry.tags?.includes(term.id)).map((term) => <a class="badge badge-primary mr-2" href={term.url}>#{term.name}</a>)}
        {!entry.visibility && shareMode !== 'false' && <ShareLinks entry={entry} mode={shareMode} />}
        {donate && <details class="astro-share ml-2"><summary class="btn btn-sm btn-outline-primary">打赏</summary><img class="astro-qr" src={donate} alt="打赏二维码" loading="lazy" /></details>}
      </div>}
    </article>}
    {related.length > 0 && <div class="card bg-white shadow-sm border-0 astro-related">
      <div class="card-body"><h5>相关文章</h5>{related.map((item) => <a href={item.path}>{item.title}</a>)}</div>
    </div>}
    {(guestbook || isArticle || entry.type === 'shuoshuo' || visibleComments.length > 0) && <CommentList items={visibleComments} entry={entry} guestbook={guestbook} reply={canComment} interactions={interactions} visitor={visitor} owner={owner} />}
    {canComment && <CommentForm entry={entry} guestbook={guestbook} />}
  </> : <>
    <div class="astro-list-cards" data-columns={option('article_list_waterflow', '1')}>
      {displayed.map((item) => <EntryCard entry={item} commentCount={commentsFor(item.id).length} extraLikes={likesFor(item.id)} />)}
    </div>
    {!displayed.length && <article class="post card bg-white shadow-sm border-0"><div class="card-body">没有找到相关内容。</div></article>}
    <Pagination current={page} total={total} base={baseRoute} query={querySuffix} />
  </>}
</Layout>
